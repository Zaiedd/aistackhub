---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.section === 'comparisons'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---
<BaseLayout
  title="AI Tool Comparisons"
  description="Direct, side-by-side comparisons between competing AI tools — same tasks, same criteria, no favorites."
  current="/comparisons/"
>
  <div class="wrap section-head">
    <h1>Comparisons</h1>
    <p>Head-to-head tests between competing tools, run on the same tasks so the comparison is actually fair.</p>
  </div>
  <section class="wrap">
    <ul class="entry-list">
      {posts.map(post => (
        <li class="entry">
          <time datetime={post.data.date}>
            {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          <div>
            <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
            <p class="dek">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
    {posts.length === 0 && <p class="dek">No comparisons published yet.</p>}
  </section>
</BaseLayout>
