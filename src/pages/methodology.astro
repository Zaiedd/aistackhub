import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Our methodology" description="How AIStackHub researches, verifies, and publishes articles." current="/methodology/">
  <div class="wrap section-head">
    <h1>Our methodology</h1>
    <p>How we research, verify, and publish.</p>
  </div>
  <section class="wrap article-body prose">
    <h2>Primary sources only</h2>
    <p>Every number, link, and conclusion in an article must be traceable to a primary source that we read this session: a DOI, an arXiv preprint, an official documentation page, or a published report. If we cannot verify a claim, we remove it or soften it rather than publish it.</p>

    <h2>No invented URLs</h2>
    <p>We do not guess or construct URLs. Links point to sources we actually opened and read.</p>

    <h2>What we check</h2>
    <ul>
      <li>Quantitative claims are quoted from the source's abstract or results, not paraphrased into a stronger statement.</li>
      <li>Comparisons use the same metric and dataset on both sides, or we say they are not directly comparable.</li>
      <li>Vendor marketing claims are labelled as such and never presented as independent evidence.</li>
    </ul>

    <h2>Corrections</h2>
    <p>When a source turns out to be wrong or a number was misread, we correct the article and note the change. If you spot an error, <a href="/contact/">contact us</a>.</p>

    <h2>Independence</h2>
    <p>AIStackHub is independent. We are not paid by the vendors we review, and we do not run affiliate links in articles.</p>
  </section>
</BaseLayout>
