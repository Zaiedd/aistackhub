---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 220));
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.section === post.data.section)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3)
  .map(p => ({ slug: p.slug, title: p.data.title, description: p.data.description }));
const sectionLabels = {
  'ai-for-students': 'AI for Students',
  'ai-for-developers': 'AI for Developers',
  'ai-for-business': 'AI for Business',
  'comparisons': 'Comparisons',
};
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  section={sectionLabels[post.data.section]}
  readingTime={readingTime}
  related={related}
>
  <Content />
</PostLayout>
