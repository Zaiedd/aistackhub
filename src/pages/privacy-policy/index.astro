---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Privacy Policy"
  description="How AIStackHub handles cookies, ads, and visitor data."
>
  <div class="wrap section-head prose" style="padding-bottom: 3rem;">
    <h1>Privacy Policy</h1>
    <p>
      This is placeholder text. Before publishing, generate a real privacy policy that
      discloses: use of cookies, any ad networks (e.g. Google AdSense) and their use of
      cookies for personalized ads, any analytics tools, and how visitors can opt out.
      A free generator (e.g. termly.io or privacypolicygenerator.info) covers this in a
      few minutes — AdSense will reject your application without one.
    </p>
  </div>
</BaseLayout>
