---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search AIStackHub articles." current="/search/">
  <div class="wrap section-head">
    <h1>Search</h1>
    <p>Search across all articles.</p>
  </div>
  <section class="wrap">
    <input id="q" type="search" placeholder="Type to search..." style="width:100%;padding:.6rem .8rem;font-size:1rem;border:1px solid var(--line);border-radius:4px;background:var(--paper);color:var(--ink);" />
    <ul id="results" class="entry-list" style="margin-top:1.5rem;"></ul>
    <p id="empty" class="dek" style="display:none;margin-top:1rem;">No matching articles.</p>
  </section>
  <script is:inline>
    (function () {
      const input = document.getElementById('q');
      const list = document.getElementById('results');
      const empty = document.getElementById('empty');
      let data = [];
      fetch('/search.json').then(r => r.json()).then(d => { data = d; render(''); });
      function render(q) {
        const term = q.trim().toLowerCase();
        const filtered = term
          ? data.filter(p =>
              p.title.toLowerCase().includes(term) ||
              p.description.toLowerCase().includes(term) ||
              (p.tags || []).some(t => t.toLowerCase().includes(term)))
            )
          : data.slice(0, 12);
        list.innerHTML = filtered.map(p =>
          `<li class="entry"><div><h2 style="font-size:1.05rem;"><a href="/posts/${p.slug}/">${escapeHtml(p.title)}</a></h2><p class="dek">${escapeHtml(p.description)}</p></div></li>`
        ).join('');
        empty.style.display = (term && filtered.length === 0) ? 'block' : 'none';
      }
      input.addEventListener('input', e => render(e.target.value));
      function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    })();
  </script>
</BaseLayout>
